# GençTek — ortam değişkenleri örneği
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. .env depoya girmez.

# PostgreSQL bağlantısı.
# VPS'te uygulamaya ÖZEL bir veritabanı ve kullanıcı açın; "postgres" veya
# "template1" gibi sistem veritabanlarını kullanmayın.
DATABASE_URL="postgresql://genctek:SIFRE_BURAYA@localhost:5432/genctek?schema=public"

# Kimlik doğrulama sağlayıcısı: "mock" | "eba" | "kayit"
#   mock  — geliştirme: giriş ekranında listeden kimlik seçilir (şifresiz).
#   kayit — EBA SSO gelene kadar pilot: öğrenci/öğretmen /kayit ekranından
#           kendi hesabını açar, T.C. kimlik no + şifreyle girer. İlk proje
#           yöneticisi: YONETICI_SIFRE='...' npm run kullanici:yonetici -- --tc ... --ad ... --soyad ... --cinsiyet E|K
#   eba   — gerçek SSO (henüz yazılmadı).
AUTH_PROVIDER="mock"

# Mock giriş ŞİFRESİZDİR: giriş ekranındaki listeden bir kimlik seçen herkes o
# kişi olarak (il koordinatörü dahil) sisteme girer. Bu yüzden NODE_ENV=production
# altında AUTH_PROVIDER="mock" açılışı reddedilir. Kapalı bir ağda bilerek mock
# ile çalışıyorsanız riski üstlendiğinizi burada yazın: "evet"
URETIMDE_MOCK_GIRISE_IZIN_VER="hayir"

# Uygulamanın önünde duran ve x-forwarded-for başlığına kendi gördüğü adresi
# EKLEYEN vekil sayısı. İstemcinin gerçek adresi zincirin SONUNDAN sayılarak
# bulunur; başlığın başına yazılanlar istemcinin uydurmasıdır.
#   1  → tek ters vekil (nginx ya da Apache) — bu projenin iki kurulumu da böyle
#   0  → uygulama doğrudan internete açık; iletilen başlıkların hiçbirine güvenilmez
#   2+ → vekilin önünde CDN/yük dengeleyici gibi ikinci bir katman varsa
# Değeri EKSİK vermek, istemcinin uydurduğu adresin gerçek sanılması demektir
# (hız sınırı atlatılır, erişim kaydına sahte IP yazılır). Şüphede kalırsanız
# büyük tutun: fazla verildiğinde adres "bilinmeyen" olur, sınır sıkılaşır.
GUVENILEN_VEKIL_SAYISI="1"

# Oturum çerezini imzalamak için kullanılır. Üretimde mutlaka değiştirin;
# aşağıdaki örnek değerle NODE_ENV=production açılışı reddedilir:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTURUM_GIZLI_ANAHTARI="gelistirme-ortami-icin-gecici-anahtar-degistirin"

# Uygulamanın kök dizini.
# Kendi alan adına kuruluyorsa BOŞ bırakın.
# Bir alt dizine kuruluyorsa (ör. https://ornek.gov.tr/genctek) "/genctek" yazın.
# DİKKAT: bu değer derleme zamanında sabitlenir — değiştirdikten sonra
# "npm run build" çalıştırmadan etkili olmaz.
TEMEL_YOL=""

# Uygulamanın hizmet verdiği host adları (virgülle ayrık). Üretimde ZORUNLU.
# Parola sıfırlama bağlantısının adresi istek başlıklarından türetilir; bu
# başlıkları istemci belirlediği için türetilen host bu listeye karşı sınanır.
# Aksi halde saldırgan, kurbanın e-postasına kendi alan adına giden bir
# sıfırlama bağlantısı göndertebilir. Geliştirmede boş bırakılabilir.
IZINLI_HOSTLAR=""

# Dosya depolama: "yerel" | "s3"
# Yerel dizin, uygulama kullanıcısının yazabildiği ve YEDEKLENEN bir yol olmalı.
DEPOLAMA_SAGLAYICI="yerel"
DEPOLAMA_YEREL_DIZIN="./depolama"

# S3 uyumlu depolama (DEPOLAMA_SAGLAYICI="s3" ise zorunlu)
S3_UC_NOKTASI=""
S3_BOLGE=""
S3_KOVA=""
S3_ERISIM_ANAHTARI=""
S3_GIZLI_ANAHTAR=""

# EBA SSO (AUTH_PROVIDER="eba" ise zorunlu; erişim sağlandığında doldurulacak)
EBA_SSO_URL=""
EBA_ISTEMCI_ID=""
EBA_ISTEMCI_SIFRE=""

# E-posta bildirimi: "kapali" | "gunluk" | "smtp"
# Panel bildirimi her koşulda yazılır; e-posta yalnızca bir kopyadır.
#   kapali → hiç denenmez
#   gunluk → gönderilmez, sunucu günlüğüne yazılır (varsayılan)
#   smtp   → kurum posta sunucusuna gönderilir
# Yanlış yapılandırmayla gerçek öğrencilere posta gitmesin diye varsayılan
# "gunluk"tur; üretimde bilinçli olarak "smtp" yapın.
EPOSTA_SAGLAYICI="gunluk"

# SMTP (EPOSTA_SAGLAYICI="smtp" ise SMTP_SUNUCU ve EPOSTA_GONDEREN zorunlu)
EPOSTA_GONDEREN="GençTek <genctek@meb.gov.tr>"
SMTP_SUNUCU=""
SMTP_PORT="587"
SMTP_KULLANICI=""
SMTP_SIFRE=""

# SMS bildirimi: "kapali" | "gunluk" | "http"
# E-postadan farklı olarak varsayılan KAPALIDIR: SMS ücretli, geri alınamaz ve
# alıcıların çoğu 18 yaş altı. Panel bildirimi her koşulda yazılır.
#   kapali → hiç denenmez (varsayılan)
#   gunluk → gönderilmez, sunucu günlüğüne yazılır
#   http   → operatör/toplu SMS servisinin uç noktasına gönderilir
SMS_SAGLAYICI="kapali"

# Toplu SMS servisi (SMS_SAGLAYICI="http" ise SMS_API_URL ve SMS_API_ANAHTARI zorunlu)
SMS_API_URL=""
SMS_API_ANAHTARI=""
SMS_BASLIK="MEB"
